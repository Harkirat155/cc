      "status": "deprecated",
      "manifestVersion": "1.0",
      "sunset": "14 days after the Worker cut-over (brick 15 of ADR 0001); no calendar date yet",
      "replacedBy": "protocol",
      "url": "https://crisscross-backend.fly.dev",
      "namespace": "/",
      "path": "/socket.io",
      "version": "4.x",
      "transports": [
        "websocket",
        "polling"
      ],
      "backend": {
        "url": "https://crisscross-backend.fly.dev",
        "healthUrl": "https://crisscross-backend.fly.dev/health",
        "feedbackUrl": "https://crisscross-backend.fly.dev/feedback"
      },
      "events": {
